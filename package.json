{
  "name": "freshland",
  "description": "TODO: Freshland is a CLI tool that lets you to clone repositories",
  "version": "3.1.0-beta.3",
  "author": "ProxityStudios",
  "license": "MIT",
  "homepage": "https://github.com/ProxityStudios/freshland/blob/main/README.md",
  "main": "dist/freshland/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/ProxityStudios/freshland/issues"
  },
  "keywords": [
    "freshland",
    "cloner",
    "clone",
    "javascript",
    "git",
    "bash-script",
    "bash"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProxityStudios/freshland.git"
  },
  "files": [
    "/bin",
    "/dist"
  ],
  "scripts": {
    "test": "./bin/dev.js",
    "test-export": "node --enable-source-maps --experimental-specifier-resolution=node -r ts-node/register test/index.ts --verbose",
    "build": "run-s format clean tsc",
    "tsc": "tsc --build",
    "clean": "rimraf dist/ package/",
    "format": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "postpublish": "rimraf dist/ package/"
  },
  "bin": {
    "freshland": "bin/run.js"
  },
  "exports": "./dist/freshland/index.js",
  "oclif": {
    "bin": "freshland",
    "commands": "./dist/commands",
    "dirname": "freshland",
    "topicSeparator": " "
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.3",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@types/node": "24.0.7",
    "@types/shelljs": "^0.8.16",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semantic-release": "24.2.6",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@inquirer/prompts": "7.5.3",
    "@oclif/core": "4.4.0",
    "https-proxy-agent": "7.0.6",
    "shell-exec": "1.1.2",
    "tar": "7.4.3"
  }
}
