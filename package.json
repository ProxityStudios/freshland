{
  "name": "freshland",
  "description": "Freshland is a CLI tool that lets you to clone repositories faster and comes with additinional features.",
  "version": "4.0.0-beta.12",
  "author": "ProxityStudios",
  "license": "MIT",
  "homepage": "https://github.com/ProxityStudios/freshland/blob/main/README.md",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/ProxityStudios/freshland/issues"
  },
  "keywords": [
    "freshland",
    "eslint",
    "prettier",
    "template",
    "templates",
    "cli",
    "clone"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProxityStudios/freshland.git"
  },
  "files": [
    "/bin",
    "/scripts",
    "/dist"
  ],
  "scripts": {
    "test": "./bin/dev.js",
    "test-export": "node --enable-source-maps --experimental-specifier-resolution=node -r ts-node/register test/index.ts --verbose",
    "build": "run-s format clean build:esm build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rimraf dist/",
    "format": "eslint . --fix",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "fetch-templates": "node ./scripts/fetchTemplates.js",
    "postinstall": "node ./scripts/postinstall.js"
  },
  "bin": {
    "freshland": "bin/run.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "oclif": {
    "bin": "freshland",
    "commands": "./src/commands",
    "dirname": "freshland",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-not-found"
    ],
    "update": {
      "autoupdate": {
        "rollout": 50,
        "debounce": 60
      },
      "node": {
        "version": "22.16.0"
      }
    },
    "topicSeparator": " "
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.3",
    "@semantic-release/npm": "12.0.2",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@types/node": "24.0.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semantic-release": "24.2.6",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@inquirer/prompts": "7.5.3",
    "@oclif/core": "4.4.0",
    "@oclif/plugin-help": "6.2.31",
    "@oclif/plugin-not-found": "3.2.59",
    "@oclif/plugin-warn-if-update-available": "3.1.44",
    "https-proxy-agent": "7.0.6",
    "tar": "7.4.3"
  }
}
