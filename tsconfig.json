{
	"ts-node": {
		"transpileOnly": true
	},
	"compilerOptions": {
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "target": "ES2022",
	  "module": "Node16",
	  "moduleResolution": "Node16",
	  "allowJs": true,
	  "resolveJsonModule": true,
	  "forceConsistentCasingInFileNames": true,
	  "isolatedModules": true,
	  "strict": true,
	  "noImplicitOverride": true,
	  "sourceMap": true,
	  "declaration": true,
	  "declarationMap": true,
	  "rootDir": "./src",
	  "outDir": "dist",
	},
	"include": [
	  "src/**/*.ts",
	],
	"exclude": [
	  "node_modules",
	  "dist"
	],
  }