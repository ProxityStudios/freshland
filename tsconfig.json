{
	"compilerOptions": {
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "target": "ESNext",
	  "module": "CommonJS",
	  "allowJs": true,
	  "resolveJsonModule": true,
	  "forceConsistentCasingInFileNames": true,
	  "isolatedModules": true,
	  "strict": true,
	  "noImplicitOverride": true,
	  "sourceMap": true,
	  "outDir": "dist",
	},
	"include": [
	  "src/**/*.ts",
	],
	"exclude": [
	  "node_modules",
	  "dist"
	],
  }