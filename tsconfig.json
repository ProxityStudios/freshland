{
	"ts-node": {
		"transpileOnly": true
	},
	"compilerOptions": {
		"skipLibCheck": true,
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"strict": true,
		"noImplicitOverride": true,
		"sourceMap": false,
		"declaration": true,
		"declarationMap": false,
		"typeRoots": [
			"node_modules/@types",
		],
		"rootDir": "./src",
		"outDir": "dist",
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	],
}